{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EscenaPlan": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^esc-[0-9]{2,3}-[0-9]+$",
          "title": "Id",
          "type": "string"
        },
        "lugar": {
          "pattern": "^esc-[a-z][a-z0-9-]*$",
          "title": "Lugar",
          "type": "string"
        },
        "tiempo_diegetico": {
          "title": "Tiempo Diegetico",
          "type": "string"
        },
        "personajes": {
          "items": {
            "pattern": "^per-[a-z0-9-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Personajes",
          "type": "array"
        },
        "dialogo": {
          "default": [],
          "items": {
            "pattern": "^per-[a-z0-9-]+$",
            "type": "string"
          },
          "title": "Dialogo",
          "type": "array"
        },
        "beat": {
          "title": "Beat",
          "type": "string"
        },
        "conflicto": {
          "title": "Conflicto",
          "type": "string"
        }
      },
      "required": [
        "id",
        "lugar",
        "tiempo_diegetico",
        "personajes",
        "beat",
        "conflicto"
      ],
      "title": "EscenaPlan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "capitulo": {
      "maximum": 999,
      "minimum": 1,
      "title": "Capitulo",
      "type": "integer"
    },
    "pov": {
      "pattern": "^per-[a-z0-9-]+$",
      "title": "Pov",
      "type": "string"
    },
    "objetivo_dramatico": {
      "title": "Objetivo Dramatico",
      "type": "string"
    },
    "escenas": {
      "items": {
        "$ref": "#/$defs/EscenaPlan"
      },
      "minItems": 1,
      "title": "Escenas",
      "type": "array"
    },
    "pistas_a_plantar": {
      "default": [],
      "items": {
        "pattern": "^pis-[0-9]{3}$",
        "type": "string"
      },
      "title": "Pistas A Plantar",
      "type": "array"
    },
    "pistas_a_pagar": {
      "default": [],
      "items": {
        "pattern": "^pis-[0-9]{3}$",
        "type": "string"
      },
      "title": "Pistas A Pagar",
      "type": "array"
    },
    "hilos_que_abre": {
      "default": [],
      "items": {
        "pattern": "^hil-[0-9]{3}$",
        "type": "string"
      },
      "title": "Hilos Que Abre",
      "type": "array"
    },
    "hilos_que_cierra": {
      "default": [],
      "items": {
        "pattern": "^hil-[0-9]{3}$",
        "type": "string"
      },
      "title": "Hilos Que Cierra",
      "type": "array"
    },
    "gancho_final": {
      "enum": [
        "pregunta_abierta",
        "revelacion",
        "amenaza",
        "decision_pendiente",
        "giro",
        "calma_inquietante"
      ],
      "title": "Gancho Final",
      "type": "string"
    },
    "restriccion_de_apertura": {
      "title": "Restriccion De Apertura",
      "type": "string"
    },
    "dependencias": {
      "default": [],
      "items": {
        "maximum": 999,
        "minimum": 1,
        "type": "integer"
      },
      "title": "Dependencias",
      "type": "array"
    }
  },
  "required": [
    "capitulo",
    "pov",
    "objetivo_dramatico",
    "escenas",
    "gancho_final",
    "restriccion_de_apertura"
  ],
  "title": "FichaCapitulo",
  "type": "object"
}
