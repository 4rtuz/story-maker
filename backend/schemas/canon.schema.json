        "estado_final": {
          "title": "Estado Final",
          "type": "string"
        },
        "cambios": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CambioDeArco"
          },
          "title": "Cambios",
          "type": "array"
        }
      },
      "required": [
        "estado_inicial",
        "estado_final"
      ],
      "title": "ArcoPrevisto",
      "type": "object"
    },
    "CambioDeArco": {
      "additionalProperties": false,
      "properties": {
        "capitulo": {
          "maximum": 999,
          "minimum": 1,
          "title": "Capitulo",
          "type": "integer"
        },
        "descripcion": {
          "title": "Descripcion",
          "type": "string"
        }
      },
      "required": [
        "capitulo",
        "descripcion"
      ],
      "title": "CambioDeArco",
      "type": "object"
    },
    "EpocaYTecnologia": {
      "additionalProperties": false,
      "properties": {
        "epoca": {
          "title": "Epoca",
          "type": "string"
        },
        "existe": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Existe",
          "type": "array"
        },
        "no_existe": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "No Existe",
          "type": "array"
        }
      },
      "required": [
        "epoca"
      ],
      "title": "EpocaYTecnologia",
      "type": "object"
    },
    "Escenario": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^esc-[a-z][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "nombre": {
          "title": "Nombre",
          "type": "string"
        },
        "descripcion": {
          "title": "Descripcion",
          "type": "string"
        },
        "detalle_sensorial": {
          "title": "Detalle Sensorial",
          "type": "string"
        },
        "quien_tiene_acceso": {
          "default": [],
          "items": {
            "pattern": "^per-[a-z0-9-]+$",
            "type": "string"
          },
          "title": "Quien Tiene Acceso",
          "type": "array"
        }
      },
      "required": [
        "id",
        "nombre",
        "descripcion",
        "detalle_sensorial"
      ],
      "title": "Escenario",
      "type": "object"
    },
    "Estilo": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "guia_de_voz_narrativa": {
          "title": "Guia De Voz Narrativa",
          "type": "string"
        },
        "ritmo": {
          "$ref": "#/$defs/Ritmo"
        },
        "prohibiciones": {
          "items": {
            "type": "string"
          },
          "title": "Prohibiciones",
          "type": "array"
        },
        "parrafos_canonicos": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Parrafos Canonicos",
          "type": "array"
        },
        "convenciones_formato": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Convenciones Formato",
          "type": "object"
        }
      },
      "required": [
        "guia_de_voz_narrativa",
        "ritmo",
        "prohibiciones",
        "parrafos_canonicos"
      ],
      "title": "Estilo",
      "type": "object"
    },
    "Giro": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^rev-[0-9]{3}$",
          "title": "Id",
          "type": "string"
        },
        "contenido": {
          "title": "Contenido",
          "type": "string"
        },
        "pistas_que_la_pagan": {
          "items": {
            "pattern": "^pis-[0-9]{3}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Pistas Que La Pagan",
          "type": "array"
        },
        "capitulo_previsto": {
          "maximum": 999,
          "minimum": 1,
          "title": "Capitulo Previsto",
          "type": "integer"
        },
        "quien_la_recibe": {
          "enum": [
            "lector",
            "personaje",
            "ambos"
          ],
          "title": "Quien La Recibe",
          "type": "string"
        },
        "impacto": {
          "enum": [
            "alta",
            "media",
            "baja"
          ],
          "title": "Impacto",
          "type": "string"
        },
        "que_creia_el_lector_antes": {
          "minLength": 1,
          "title": "Que Creia El Lector Antes",
          "type": "string"
        }
      },
      "required": [
        "id",
        "contenido",
        "pistas_que_la_pagan",
        "capitulo_previsto",
        "quien_la_recibe",
        "impacto",
        "que_creia_el_lector_antes"
      ],
      "title": "Giro",
      "type": "object"
    },
    "Identidad": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^per-[a-z0-9-]+$",
          "title": "Id",
          "type": "string"
        },
        "nombre": {
          "title": "Nombre",
          "type": "string"
        },
        "alias": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Alias",
          "type": "array"
        },
        "edad": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edad"
        },
        "rol_narrativo": {
          "title": "Rol Narrativo",
          "type": "string"
        }
      },
      "required": [
        "id",
        "nombre",
        "rol_narrativo"
      ],
      "title": "Identidad",
      "type": "object"
    },
    "Institucion": {
      "additionalProperties": false,
      "properties": {
        "nombre": {
          "title": "Nombre",
          "type": "string"
        },
        "procedimientos": {
          "title": "Procedimientos",
          "type": "string"
        }
      },
      "required": [
        "nombre",
        "procedimientos"
      ],
      "title": "Institucion",
      "type": "object"
    },
    "Misterio": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "verdad_oculta": {
          "items": {
            "type": "string"
          },
          "title": "Verdad Oculta",
          "type": "array"
        },
        "culpable_o_amenaza": {
          "title": "Culpable O Amenaza",
          "type": "string"
        },
        "motivo_medio_oportunidad": {
          "$ref": "#/$defs/MotivoMedioOportunidad"
        },
        "pistas": {
          "items": {
            "$ref": "#/$defs/Pista"
          },
          "title": "Pistas",
          "type": "array"
        },
        "pistas_falsas": {
          "items": {
            "$ref": "#/$defs/PistaFalsa"
          },
          "title": "Pistas Falsas",
          "type": "array"
        },
        "revelaciones": {
          "items": {
            "$ref": "#/$defs/Revelacion"
          },
          "title": "Revelaciones",
          "type": "array"
        },
        "giros": {
          "items": {
            "$ref": "#/$defs/Giro"
          },
          "title": "Giros",
          "type": "array"
        },
        "reloj": {
          "$ref": "#/$defs/Reloj"
        }
