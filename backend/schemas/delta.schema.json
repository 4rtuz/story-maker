{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EntradaConocimiento": {
      "additionalProperties": false,
      "description": "Misma entrada para `conocimiento` (por personaje) y `conocimiento_lector` (plana).",
      "properties": {
        "hecho": {
          "pattern": "^hec-[0-9]{3}$",
          "title": "Hecho",
          "type": "string"
        },
        "desde_capitulo": {
          "maximum": 999,
          "minimum": 1,
          "title": "Desde Capitulo",
          "type": "integer"
        },
        "cita": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cita"
        }
      },
      "required": [
        "hecho",
        "desde_capitulo"
      ],
      "title": "EntradaConocimiento",
      "type": "object"
    },
    "EntradaTemporal": {
      "additionalProperties": false,
      "properties": {
        "escena": {
          "pattern": "^esc-[0-9]{2,3}-[0-9]+$",
          "title": "Escena",
          "type": "string"
        },
        "capitulo": {
          "maximum": 999,
          "minimum": 1,
          "title": "Capitulo",
          "type": "integer"
        },
        "inicio": {
          "title": "Inicio",
          "type": "string"
        },
        "duracion_min": {
          "minimum": 0,
          "title": "Duracion Min",
          "type": "integer"
        },
        "cita": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cita"
        }
      },
      "required": [
        "escena",
        "capitulo",
        "inicio",
        "duracion_min"
      ],
      "title": "EntradaTemporal",
      "type": "object"
    },
    "EstadoPersonaje": {
      "additionalProperties": false,
      "properties": {
        "ubicacion": {
          "anyOf": [
            {
              "pattern": "^esc-[a-z][a-z0-9-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ubicacion"
        },
        "estado_fisico": {
          "title": "Estado Fisico",
          "type": "string"
        },
        "estado_emocional": {
          "title": "Estado Emocional",
          "type": "string"
        },
        "condicion": {
          "enum": [
            "viva",
            "muerta",
            "desaparecida"
          ],
          "title": "Condicion",
          "type": "string"
        },
        "objetivo_activo": {
          "title": "Objetivo Activo",
          "type": "string"
        },
        "ultima_aparicion": {
          "maximum": 999,
          "minimum": 1,
          "title": "Ultima Aparicion",
          "type": "integer"
        }
      },
      "required": [
        "ubicacion",
        "estado_fisico",
        "estado_emocional",
        "condicion",
        "objetivo_activo",
        "ultima_aparicion"
      ],
      "title": "EstadoPersonaje",
      "type": "object"
    },
    "EventoCronologia": {
      "additionalProperties": false,
      "description": "Un evento datado: lo que alimenta `novela verificar-lean`. `momento` son minutos desde el\ndía 1 a las 00:00; `excluye`, quién sale de la historia en él (muerte o partida definitiva);\n`edades`, las que el texto declara; `tras`, los eventos que el texto sitúa antes.",
      "properties": {
        "id": {
          "pattern": "^evt-[0-9]{2,3}-[0-9]+$",
          "title": "Id",
          "type": "string"
        },
        "momento": {
          "minimum": 0,
          "title": "Momento",
          "type": "integer"
        },
        "duracion_min": {
          "default": 0,
          "minimum": 0,
          "title": "Duracion Min",
          "type": "integer"
        },
        "lugar": {
          "pattern": "^esc-[a-z][a-z0-9-]*$",
          "title": "Lugar",
          "type": "string"
        },
        "personajes": {
          "default": [],
          "items": {
            "pattern": "^per-[a-z0-9-]+$",
            "type": "string"
          },
          "title": "Personajes",
          "type": "array"
        },
        "excluye": {
          "default": [],
          "items": {
            "pattern": "^per-[a-z0-9-]+$",
            "type": "string"
          },
          "title": "Excluye",
          "type": "array"
        },
        "edades": {
          "default": {},
          "patternProperties": {
            "^per-[a-z0-9-]+$": {
              "type": "integer"
            }
          },
          "title": "Edades",
          "type": "object"
        },
        "tras": {
          "default": [],
          "items": {
            "pattern": "^evt-[0-9]{2,3}-[0-9]+$",
            "type": "string"
          },
          "title": "Tras",
          "type": "array"
        },
        "cita": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cita"
        }
      },
      "required": [
        "id",
        "momento",
        "lugar"
      ],
      "title": "EventoCronologia",
      "type": "object"
    },
    "Hecho": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^hec-[0-9]{3}$",
          "title": "Id",
          "type": "string"
        },
        "texto": {
          "title": "Texto",
          "type": "string"
        },
        "capitulo": {
          "maximum": 999,
          "minimum": 1,
          "title": "Capitulo",
          "type": "integer"
        },
        "cita": {
          "title": "Cita",
          "type": "string"
        }
      },
      "required": [
        "id",
        "texto",
        "capitulo",
        "cita"
      ],
      "title": "Hecho",
      "type": "object"
    },
    "Hilo": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^hil-[0-9]{3}$",
          "title": "Id",
          "type": "string"
        },
        "estado": {
          "enum": [
            "abierto",
            "cerrado"
          ],
          "title": "Estado",
          "type": "string"
        },
        "abierto_en": {
          "maximum": 999,
          "minimum": 1,
          "title": "Abierto En",
          "type": "integer"
        },
        "cerrado_en": {
          "anyOf": [
            {
              "maximum": 999,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cerrado En"
        },
        "descripcion": {
          "title": "Descripcion",
          "type": "string"
        }
      },
      "required": [
        "id",
        "estado",
        "abierto_en",
        "descripcion"
      ],
      "title": "Hilo",
      "type": "object"
    },
    "Objeto": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^obj-[0-9]{3}$",
          "title": "Id",
          "type": "string"
        },
        "poseedor": {
          "anyOf": [
            {
              "pattern": "^per-[a-z0-9-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Poseedor"
        },
        "ubicacion": {
          "anyOf": [
            {
              "pattern": "^esc-[a-z][a-z0-9-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ubicacion"
        },
        "capitulo_intro": {
          "maximum": 999,
          "minimum": 1,
          "title": "Capitulo Intro",
          "type": "integer"
        },
        "relevancia": {
          "enum": [
            "alta",
            "media",
            "baja"
          ],
          "title": "Relevancia",
          "type": "string"
        }
      },
      "required": [
        "id",
        "poseedor",
        "ubicacion",
        "capitulo_intro",
        "relevancia"
      ],
      "title": "Objeto",
      "type": "object"
    },
    "Relacion": {
      "additionalProperties": false,
      "description": "Arista de la evolución; `intensidad` es cuantitativa y no es la `tension` del canon.",
      "properties": {
        "de": {
          "pattern": "^per-[a-z0-9-]+$",
          "title": "De",
          "type": "string"
        },
        "a": {
          "pattern": "^per-[a-z0-9-]+$",
          "title": "A",
          "type": "string"
        },
        "tipo": {
          "title": "Tipo",
          "type": "string"
        },
        "intensidad": {
          "maximum": 1,
          "minimum": 0,
          "title": "Intensidad",
          "type": "number"
        },
        "desde": {
          "maximum": 999,
          "minimum": 1,
          "title": "Desde",
          "type": "integer"
        }
      },
      "required": [
        "de",
        "a",
        "tipo",
        "intensidad",
        "desde"
      ],
      "title": "Relacion",
      "type": "object"
    },
    "Resumen": {
      "additionalProperties": false,
      "description": "Las tres granularidades de un capítulo, de la más corta a la más fina. `escena` va por id\nde escena y no como prosa: es lo que deja abiertas las capas exacta y léxica del índice\nrecuperable (architecture.md §12.4) sin reprocesar capítulos.",
      "properties": {
        "linea": {
          "minLength": 1,
          "title": "Linea",
          "type": "string"
        },
        "parrafo": {
          "minLength": 1,
          "title": "Parrafo",
          "type": "string"
        },
        "escena": {
          "minProperties": 1,
          "patternProperties": {
            "^esc-[0-9]{2,3}-[0-9]+$": {
              "type": "string"
            }
          },
          "title": "Escena",
          "type": "object"
        }
      },
      "required": [
        "linea",
        "parrafo",
        "escena"
      ],
      "title": "Resumen",
      "type": "object"
    },
    "UsoCitado": {
      "additionalProperties": false,
      "description": "Un hecho ya afirmado que el capítulo usa sin enseñarlo de nuevo, con la cita literal que\nlo prueba. Es lo que deja rastro en `usos_de_hecho` por la vía `cita` (spec 0007, D4).",
      "properties": {
        "hecho": {
          "pattern": "^hec-[0-9]{3}$",
          "title": "Hecho",
          "type": "string"
        },
        "cita": {
          "minLength": 1,
          "title": "Cita",
          "type": "string"
        }
      },
      "required": [
        "hecho",
        "cita"
      ],
      "title": "UsoCitado",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`estado/deltas/NN.json`: la salida del cronista y la única entrada de `aplicar-delta`.\n\nLas append-only traen solo altas; las mutables, el estado nuevo de lo que el capítulo toca.\n`hilos` lleva solo los que se abren o se cierran en el capítulo, y tiene que casar con el\nfrontmatter. No vienen `pistas` ni `metricas`, que se derivan, ni `tension_real`, que es\ndel lector-suspense, ni el cursor, que avanza `aplicar-delta` desde `capitulo`.",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "capitulo": {
      "maximum": 999,
      "minimum": 1,
      "title": "Capitulo",
      "type": "integer"
    },
    "linea_temporal": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EntradaTemporal"
      },
      "title": "Linea Temporal",
      "type": "array"
    },
    "personajes": {
      "default": {},
      "patternProperties": {
        "^per-[a-z0-9-]+$": {
          "$ref": "#/$defs/EstadoPersonaje"
        }
      },
      "title": "Personajes",
      "type": "object"
    },
    "conocimiento": {
      "default": {},
      "patternProperties": {
        "^per-[a-z0-9-]+$": {
          "items": {
            "$ref": "#/$defs/EntradaConocimiento"
          },
          "type": "array"
        }
      },
      "title": "Conocimiento",
      "type": "object"
    },
    "conocimiento_lector": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EntradaConocimiento"
      },
      "title": "Conocimiento Lector",
      "type": "array"
    },
    "relaciones": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Relacion"
      },
      "title": "Relaciones",
      "type": "array"
    },
    "objetos": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Objeto"
      },
      "title": "Objetos",
      "type": "array"
    },
    "libro_de_hechos": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Hecho"
      },
      "title": "Libro De Hechos",
      "type": "array"
    },
    "hechos_usados": {
      "default": [],
      "items": {
        "$ref": "#/$defs/UsoCitado"
      },
      "title": "Hechos Usados",
      "type": "array"
    },
    "hilos": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Hilo"
      },
      "title": "Hilos",
      "type": "array"
    },
    "resumen": {
      "$ref": "#/$defs/Resumen"
    },
    "cronologia": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EventoCronologia"
      },
      "title": "Cronologia",
      "type": "array"
    }
  },
  "required": [
    "capitulo",
    "resumen"
  ],
  "title": "Delta",
  "type": "object"
}
