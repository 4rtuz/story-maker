{
  "permissions": {
    "allow": ["Agent", "Bash(novela:*)", "Edit(./novelas/**)"],
    "deny": [
      "Read(./novelas/*/canon/misterio.md)",
      "Edit(./novelas/*/estado/estado.db*)",
      "Edit(./novelas/*/estado/state.lock)",
      "Bash(sqlite3:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Read|Bash|PowerShell|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/denegar-escritura-estado.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/validar-capitulo.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
